# Normalize source code before commits
.gitattributes text eol=lf
*.lua eol=lf 
*.md  text eol=lf
*.txt eol=lf 
*.ot* eol=lf
# the minimap (tools/gen_minimap.py) is binary: *.ot* above would rewrite its bytes
*.otmm binary
*.cpp eol=lf 
*.h   eol=lf 
# assets do cliente (data/things/1310): bytes exatos, o hash do nome e do catalog-content.json precisa bater
data/things/1310/** binary
