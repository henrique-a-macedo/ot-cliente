// one talent: a square whose size and color follow its kind (small, notable, keystone...)
TalentNode < UIButton
  size: 22 22
  background-color: #1e1e1e
  border-width: 2
  border-color: #4a4a4a
  font: verdana-9px-rounded
  color: #dfdfdf
  text-align: center

  $hover:
    background-color: #3a3a3a

// a straight connector between two nodes, rotated to the angle between them (pivot at its center)
TalentLink < UIWidget
  height: 2
  background-color: #5a5a5a
  phantom: true

MainWindow
  id: talentsWindow
  !text: tr('Talents')
  size: 760 600
  visible: false
  @onEscape: modules.game_talents.hide()

  Button
    id: talentTab
    !text: tr('Talents')
    width: 90
    anchors.top: parent.top
    anchors.left: parent.left
    @onClick: modules.game_talents.open('talent')

  Button
    id: paragonTab
    !text: tr('Paragon')
    width: 90
    anchors.top: parent.top
    anchors.left: talentTab.right
    margin-left: 4
    @onClick: modules.game_talents.open('paragon')

  Button
    id: centerButton
    !text: tr('Center')
    width: 60
    anchors.top: parent.top
    anchors.left: paragonTab.right
    margin-left: 12
    @onClick: modules.game_talents.center()

  Label
    id: points
    anchors.verticalCenter: talentTab.verticalCenter
    anchors.right: parent.right
    color: #8fd18f
    text-auto-resize: true

  Label
    id: keystones
    anchors.verticalCenter: talentTab.verticalCenter
    anchors.right: points.left
    margin-right: 16
    color: #d8b03c
    text-auto-resize: true

  UIWidget
    id: canvas
    anchors.top: talentTab.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: resultLabel.top
    margin-top: 8
    margin-bottom: 6
    background-color: #00000055
    border-width: 1
    border-color: #2a2a2a
    clipping: true

  Label
    id: hint
    !text: tr('Drag to move, mouse wheel to zoom.')
    anchors.bottom: canvas.bottom
    anchors.left: canvas.left
    margin-left: 6
    margin-bottom: 4
    color: #808080
    text-auto-resize: true
    phantom: true

  Label
    id: resultLabel
    anchors.left: parent.left
    anchors.right: resetButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    height: 20
    text-wrap: true

  Button
    id: resetButton
    !text: tr('Reset')
    width: 110
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    @onClick: modules.game_talents.askReset()

  Button
    id: closeButton
    !text: tr('Close')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_talents.hide()
