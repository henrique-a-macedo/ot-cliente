// the withdraw modal, like Tibia's "Move Stackable Item": the stone's icon, how many on a slider (starts at all),
// Withdraw / Cancel. Arrows and PageUp/PageDown move the slider, Enter confirms, Escape cancels (pouch.lua).
// With a single unit the right click withdraws it directly and this window never opens.
MainWindow
  id: withdrawWindow
  !text: tr('Withdraw')
  size: 280 116
  visible: false
  @onEscape: modules.game_pouch.cancelWithdraw()
  @onEnter: modules.game_pouch.confirmWithdraw()

  Item
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 2
    virtual: true
    focusable: false

  Label
    id: what
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: item.top
    margin-left: 8
    margin-top: 1
    color: #dfdfdf

  HorizontalScrollBar
    id: count
    anchors.left: what.left
    anchors.right: parent.right
    anchors.top: what.bottom
    margin-top: 5
    focusable: false

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: cancelButton.top
    margin-bottom: 8

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_pouch.cancelWithdraw()

  Button
    id: okButton
    !text: tr('Withdraw')
    width: 64
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    @onClick: modules.game_pouch.confirmWithdraw()
