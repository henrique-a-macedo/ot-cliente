// section title (General, League)
PouchGroupTitle < Label
  font: verdana-11px-antialised
  color: #e8c860
  height: 20
  text-offset: 2 4
  background-color: #ffffff12
  margin-top: 4

PouchEmpty < Label
  height: 18
  text-offset: 12 2
  color: #808080

PouchRow < UIWidget
  height: 38
  background-color: #ffffff0a
  margin-bottom: 2

  Item
    id: icon
    size: 32 32
    virtual: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3

  Label
    id: name
    anchors.left: icon.right
    anchors.right: withdraw.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 4
    color: #dfdfdf

  Label
    id: amount
    anchors.left: name.left
    anchors.right: name.right
    anchors.top: name.bottom
    margin-top: 2
    color: #8fd18f

  Button
    id: withdraw
    !text: tr('Withdraw')
    width: 70
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4

MainWindow
  id: pouchWindow
  !text: tr('Currency Pouch')
  size: 330 380
  visible: false
  @onEscape: modules.game_pouch.hide()

  Label
    id: hint
    !text: tr('Kept outside your bags: no weight, no slot. Use a stone item to put it here.')
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true
    color: #a0a0a0

  ScrollablePanel
    id: list
    anchors.top: hint.bottom
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.bottom: resultLabel.top
    margin-top: 6
    margin-bottom: 6
    vertical-scrollbar: listScroll
    layout:
      type: verticalBox

  // anchored to the same neighbours as the list, never to the list: list -> scrollbar -> list is an anchor loop
  VerticalScrollBar
    id: listScroll
    anchors.top: hint.bottom
    anchors.bottom: resultLabel.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 6
    step: 20
    pixels-scroll: true

  Label
    id: resultLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    height: 20
    text-wrap: true

  Button
    id: closeButton
    !text: tr('Close')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_pouch.hide()
