// section title (General, League), like the VIP groups: white text over a separator
PouchGroupTitle < Label
  height: 20
  margin-top: 8
  padding-left: 2
  color: #f7f7f7
  text-align: left

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

  $first:
    margin-top: 4

PouchEmpty < Label
  height: 14
  text-offset: 8 1
  font: verdana-9px-rounded
  color: #808080

// one line: name on the left, amount on the right; a right click takes some out (pouch.lua, tooltip says so)
PouchRow < UIWidget
  height: 18
  margin-top: 2
  padding-left: 4
  padding-right: 4
  // the hover color only goes away if the base state sets one to return to
  background-color: alpha

  $hover:
    background-color: #ffffff18

  Label
    id: amount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    color: #8fd18f
    phantom: true

  Label
    id: name
    anchors.left: parent.left
    anchors.right: amount.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    color: #dfdfdf
    phantom: true

MiniWindow
  id: pouchWindow
  height: 180
  @onOpen: modules.game_pouch.onMiniWindowOpen()
  @onClose: modules.game_pouch.onMiniWindowClose()
  &save: true

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 6
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Currency Pouch')
    color: #9d9d9dff

  // the window sets this panel's height (anchored top and bottom): fit-children here fights it and the layout
  // never settles (the client froze); rows scroll instead, like the VIP list
  MiniWindowContents
    id: contentsPanel
    padding-left: 3
    padding-right: 3
    padding-bottom: 3
    layout: verticalBox
