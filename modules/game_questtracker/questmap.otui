// quest places on the minimap (questmap.lua): a patch over a whole area, never the spawn spots
// a see-through patch over the area where they spawn
QuestPlaceArea < UIWidget
  phantom: true
  background-color: #ffc14a38
  border-width: 1
  border-color: #ffc14a59

  Label
    id: name
    anchors.centerIn: parent
    font: verdana-11px-rounded
    color: #f0d890
    text-auto-resize: true
    phantom: true

// the places the journal asked to see
QuestPlaceFocus < QuestPlaceArea
  background-color: #4fa3ff40
  border-color: #4fa3ff66

// where available quests start; one per spot, the names in the tooltip
QuestPlaceStart < Label
  size: 12 16
  text: !
  font: verdana-11px-rounded
  color: #ffd84a
  text-align: center
  background-color: #00000099
  border-width: 1
  border-color: #ffd84a
