// the quest GPS (questmap.lua): at the top of the game screen, an arrow towards the marker, the place and the squares
QuestGps < UIWidget
  size: 260 52
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 40
  background-color: #000000b0
  border-width: 1
  border-color: #e8c46a80
  focusable: false
  visible: false

  UIWidget
    id: arrow
    size: 28 28
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    image-source: /game_questtracker/images/gps-arrow
    phantom: true

  Label
    id: text
    anchors.left: arrow.right
    anchors.right: close.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised
    color: #ffffff
    text-auto-resize: true
    phantom: true

  UIButton
    id: close
    size: 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 3
    text: x
    color: #c0c0c0
    !tooltip: tr('Stop guiding')
