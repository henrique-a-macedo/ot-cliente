// quest places on the full map (questmap.lua); the colour of each quest is set in Lua

// one cell (8, 16... tiles) of a hunting ground that has a spawn: together they draw the shape of the ground
QuestPlaceCell < UIWidget
  phantom: true
  background-color: #ff3b3080

// a place without a shape (an NPC, an area to reach, before the shapes arrive)
QuestPlaceArea < UIWidget
  phantom: true
  background-color: #ff3b3080
  border-width: 1
  border-color: #ff3b30e0

// the list over a place: (quest,) place, then one line per monster; dark backing, a border in the quest colour
QuestPlaceLabel < Label
  font: verdana-11px-antialised
  color: #ffffff
  background-color: #000000c0
  border-width: 1
  border-color: #ff3b30
  padding: 2 5 2 5
  text-auto-resize: true
  phantom: true
