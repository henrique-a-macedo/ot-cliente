PhantomMiniWindow
  id: mainmappanel
  draggable: true
  phantom: false
  &panelHeight: 116
  height: 116

  // extended view only: the title bar; drag it to the other half of the screen to move the minimap there
  UIWidget
    id: dragHandle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    margin: 3
    margin-bottom: 0
    image-source: /images/ui/miniwindow_header
    image-border: 4
    font: verdana-11px-antialised
    color: #c0c0c0
    text-align: center
    !text: tr('Minimap')
    draggable: true
    visible: false
    !tooltip: tr('Drag to move the minimap to the other side')

  UIWidget
    id: minimapBorder
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 3
    image-source: /images/ui/1pixel_down_frame

    Minimap
      id: minimap
      anchors.fill: parent
      margin: 1
